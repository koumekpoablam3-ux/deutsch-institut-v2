generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  password      String?
  telephone     String?
  /// Niveau de l'utilisateur. Valeurs valides : A1, A2, B1, B2, C1, C2
  niveau        String   @default("A1")
  /// Rôle de l'utilisateur. Valeurs valides : student, admin
  role          String   @default("student")
  emailVerified DateTime?
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enrollments  Enrollment[]
  chatMessages ChatMessage[]
  passwordResetTokens PasswordResetToken[]
  reviews       Review[]
  notifications Notification[]
  payments      Payment[]
  articles      Article[]
  moduleProgress ModuleProgress[]
  quizAttempts  QuizAttempt[]
  certificates  Certificate[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  /// Niveau du cours. Valeurs valides : A1, A2, B1, B2, C1, C2
  level       String
  lessons     Int
  duration    String
  /// Display price (e.g. '150 000 FCFA')
  price       String
  badge       String?
  badgeColor  String?
  image       String
  description String
  objectives  String
  prerequisites String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments Enrollment[]
  reviews     Review[]
  payments    Payment[]
  liveSessions LiveSession[]
  modules     CourseModule[]
  questions   QuizQuestion[]
  attempts    QuizAttempt[]
  certificates Certificate[]
}

model CourseModule {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  /// Type de module. Valeurs valides : pdf, video, text, link
  type        String   @default("text")
  /// Contenu texte, ou URL pour type video/link
  content     String?
  fileName    String?
  /// Fichier encodé en base64 (PDF importé par l'admin)
  fileData    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    ModuleProgress[]

  @@index([courseId])
}

model ModuleProgress {
  id          String   @id @default(cuid())
  userId      String
  moduleId    String
  completedAt DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
}

model QuizQuestion {
  id            String   @id @default(cuid())
  courseId      String
  question      String
  /// Liste des choix de réponse, encodée en JSON (ex: ["Option A","Option B"])
  options       String
  correctIndex  Int
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model QuizAttempt {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  score      Int
  total      Int
  passed     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
}

model Certificate {
  id                  String   @id @default(cuid())
  userId              String
  courseId            String
  certificateNumber   String   @unique
  issuedAt            DateTime @default(now())

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course              Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  progress  Int      @default(0)
  /// Statut de l'inscription. Valeurs valides : active, completed, cancelled
  status    String   @default("active")
  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  nom       String
  prenom    String
  email     String
  telephone String
  niveau    String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  /// Rôle du message. Valeurs valides : user, assistant
  role      String
  content   String
  correction String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  /// Type de notification. Valeurs valides : info, success, warning, error
  type      String   @default("info")
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Payment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  /// Display amount (e.g. '150 000 FCFA')
  amount    String
  /// Statut du paiement. Valeurs valides : pending, completed, failed, refunded
  status    String   @default("completed")
  /// Méthode de paiement. Valeurs valides : carte, mobile_money, virement, espece
  method    String   @default("carte")
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model LiveSession {
  id              String   @id @default(cuid())
  courseId        String
  title           String
  description     String?
  startAt         DateTime
  durationMinutes Int      @default(60)
  roomName        String   @unique
  createdAt       DateTime @default(now())

  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  coverImage  String?
  published   Boolean  @default(true)
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User     @relation(fields: [authorId], references: [id])
}

// ─────────────────────────────────────────────────────────────
// Contenu de la page d'accueil, modifiable depuis le panneau admin
// ─────────────────────────────────────────────────────────────

/// Un slide du carrousel de la page d'accueil.
model HeroSlide {
  id             String   @id @default(cuid())
  /// Ordre d'affichage (0 = premier)
  position       Int      @default(0)
  /// Slide visible sur le site ou masqué
  active         Boolean  @default(true)
  /// URL de l'image de fond : /api/media/<id> (image téléversée), /images/... ou https://...
  image          String
  /// Assombrissement de l'image en % (100 = voile standard, 0 = aucun)
  overlay        Int      @default(100)
  title          String
  highlight      String   @default("")
  subtitle       String   @default("")
  /// Badge propre à ce slide (null = badge global défini dans les réglages)
  badge          String?
  /// Pastilles blanches (ex. "En présentiel", "En ligne")
  pills          String[] @default([])
  /// Étiquettes dorées (ex. liste des pays) + texte introductif
  tags           String[] @default([])
  tagsTitle      String?
  /// Bloc partenaire (logo + texte)
  partnerName    String?
  partnerLogo    String?
  partnerText    String?
  /// Boutons d'action (null = valeurs par défaut du site)
  showButtons    Boolean  @default(true)
  primaryLabel   String?
  primaryHref    String?
  secondaryLabel String?
  secondaryHref  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([position])
}

/// Réglages du site au format clé / valeur JSON (hero, stats, cta).
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Images téléversées depuis l'admin, stockées directement dans PostgreSQL.
model Media {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}
